rules_version = '2';
// Sumin 방명록 보안 규칙. Firebase 콘솔 > Firestore Database > 규칙 탭에 통째로 붙여 넣고 "게시"를 누르세요.
// ADMIN_UID 자리에 숨님 구글 계정의 User UID를 넣어야 숨님이 다른 사람 지구를 지울 수 있어요.
service cloud.firestore {
  match /databases/{database}/documents {
    function adminUid() { return 'ADMIN_UID'; }
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // 글자 수는 화면에서 정확히 막고(닉네임 12자, 메시지 100자), 여기서는 이모지를 생각해 넉넉하게 막음
    function validPlanet(d) {
      return d.keys().hasOnly(['nickname', 'message', 'planetColor', 'cover', 'animal', 'animalColor', 'googleName', 'createdAt', 'updatedAt'])
        && d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 60
        && d.message is string && d.message.size() <= 400
        && d.planetColor is string && d.planetColor.matches('color_[1-5]')
        && d.cover is string && d.cover.matches('none|flower_[1-5]')
        && d.animal is string && d.animal.matches('monkey|cat|puppy|bear|rabbit|squirrel|duck')
        && d.animalColor is string && d.animalColor.matches('natural|peach|pink|lilac|sky|butter')
        && d.googleName is string && d.googleName.size() <= 100
        && d.updatedAt == request.time;
    }

    match /planets/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validPlanet(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validPlanet(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == adminUid());
    }
  }
}
